    "forest_lost_group":  {
                              "final_option":  "Pomoge wam dojsc.",
                              "lines":  [
                                            {
                                                "speaker":  "Zagubiona",
                                                "text":  "Pomoz nam, ona jest ciezko ranna. Jakis potwor ja pocial.",
                                                "voice_path":  "assets/audio/dialogues/StoryFinal/forest_lost_group_00.wav"
                                            },
                                            {
                                                "speaker":  "Logos",
                                                "text":  "Musicie isc do medrca na poludniu, on wam pomoze.",
                                                "voice_path":  "assets/audio/dialogues/StoryFinal/forest_lost_group_01.wav"
                                            },
                                            {
                                                "speaker":  "Zagubiona",
                                                "text":  "Tak zrobimy. Tylko nie pozwol, zeby mgla znowu nas zawrocila.",
                                                "voice_path":  "assets/audio/dialogues/StoryFinal/forest_lost_group_02.wav"
                                            }
                                        ]
                          },
    "herbalist_placeholder":  {
                                  "final_option":  "Wroce pozniej.",
                                  "lines":  [
                                                {
                                                    "speaker":  "Zielarz",
                                                    "text":  "Dach przecieka, ziola spleĹ›nialy, ale zywych tu jeszcze przyjme."
                                                },
                                                {
                                                    "speaker":  "Logos",
                                                    "text":  "Beda przychodzic ludzie z cmentarza i lasu. Jeden z rannych moze potrzebowac loza."
                                                },
                                                {
                                                    "speaker":  "Zielarz",
                                                    "text":  "Nie pytam o nazwiska, kiedy krew idzie przez palce. Przyprowadz ich, a ja bede robil, co umiem."
                                                }
                                            ]
                              },
    "witch_to_nawia":  {
                           "final_option":  "Jaka znowu lekcja?",
                           "lines":  [
                                         {
                                             "speaker":  "Wiedzma",
                                             "text":  "Wiedzialam, ze przypaleta sie kolejny!",
                                             "voice_path":  "assets/audio/dialogues/StoryFinal/witch_to_nawia_00.wav"
                                         },
                                         {
                                             "speaker":  "Logos",
                                             "text":  "O co ci chodzi, wiedzmo?",
                                             "voice_path":  "assets/audio/dialogues/StoryFinal/witch_to_nawia_01.wav"
                                         },
                                         {
                                             "speaker":  "Wiedzma",
                                             "text":  "Wiedzmo? Tak zaczynasz rozmowe? Widze, ze lekcja od bogow nic was nie nauczyla.",
                                             "voice_path":  "assets/audio/dialogues/StoryFinal/witch_to_nawia_02.wav"
                                         },
                                         {
                                             "speaker":  "Wiedzma",
                                             "text":  "Moze spotkanie ze zmarlymi czegos cie nauczy.",
                                             "voice_path":  "assets/audio/dialogues/StoryFinal/witch_to_nawia_03.wav"
                                         },
                                         {
                                             "speaker":  "Logos",
                                             "text":  "Jaka znowu lekcja?",
                                             "voice_path":  "assets/audio/dialogues/StoryFinal/witch_to_nawia_04.wav"
                                         }
                                     ]
                       },
