    "witch_death":  {
                        "final_option":  "Zobaczymy.",
                        "lines":  [
                                      {
                                          "speaker":  "Wiedzma",
                                          "text":  "Strzezcie sie boskiego gniewu. Zesla na was monstra z legend, ktore boicie sie powtarzac. Nawia na was czeka.",
