    "herbalist_final_success":  {
                                    "final_option":  "Porozmawiam z nia.",
                                    "lines":  [
                                                  {
                                                      "speaker":  "Logos",
                                                      "text":  "Wiesz, co mozemy teraz zrobic? Wiedzma mowila cos o odprawieniu dziadow. Ja musze ruszyc szukac Mileny.",
                                                      "voice_path":  "assets/audio/dialogues/StoryFinal/herbalist_final_success_00.wav"
                                                  },
                                                  {
                                                      "speaker":  "Medrzec",
                                                      "text":  "Mam dobre i zle wiesci. Dobre sa takie, ze ranna, ktora uratowales, to siostra Mileny i opowie ci cos wiecej o twojej kochanej.",
                                                      "voice_path":  "assets/audio/dialogues/StoryFinal/herbalist_final_success_01.wav"
                                                  },
                                                  {
                                                      "speaker":  "Medrzec",
                                                      "text":  "Ja wiem tylko, ze Milenie udalo sie uciec z wioski i ruszyla z innymi na zachod.",
                                                      "voice_path":  "assets/audio/dialogues/StoryFinal/herbalist_final_success_02.wav"
                                                  },
                                                  {
                                                      "speaker":  "Logos",
                                                      "text":  "O bogowie, jakie szczescie. A zle?",
                                                      "voice_path":  "assets/audio/dialogues/StoryFinal/herbalist_final_success_03.wav"
                                                  },
                                                  {
                                                      "speaker":  "Medrzec",
                                                      "text":  "Nie mozesz tam wyruszyc. Tunel do doliny sie zawalil. Odgruzowanie zajmie nam pare dni.",
                                                      "voice_path":  "assets/audio/dialogues/StoryFinal/herbalist_final_success_04.wav"
                                                  },
                                                  {
                                                      "speaker":  "Logos",
                                                      "text":  "Kurwa... niech bedzie. Co z tymi dziadami?",
                                                      "voice_path":  "assets/audio/dialogues/StoryFinal/herbalist_final_success_05.wav"
                                                  },
                                                  {
                                                      "speaker":  "Medrzec",
                                                      "text":  "Porozmawiaj z siostra Mileny, a o dziadach pomyslimy po odgruzowaniu.",
